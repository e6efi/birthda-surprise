<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مفاجأة خاصة جداً! 🎁</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 99%, #fecfef 100%);
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            overflow: hidden;
            text-align: center;
        }

        .container {
            z-index: 10;
        }

        /* تصميم الهدية */
        .gift-box {
            position: relative;
            width: 150px;
            height: 150px;
            background-color: #e74c3c;
            margin: 0 auto;
            cursor: pointer;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            border-radius: 10px;
            transition: transform 0.3s ease;
            animation: bounce 2s infinite;
        }

        .gift-box:hover {
            transform: scale(1.05);
        }

        .gift-ribbon {
            position: absolute;
            width: 25px;
            height: 100%;
            background-color: #f1c40f;
            left: 50%;
            transform: translateX(-50%);
        }

        .gift-ribbon-horizontal {
            position: absolute;
            width: 100%;
            height: 25px;
            background-color: #f1c40f;
            top: 50%;
            transform: translateY(-50%);
        }

        /* الرسالة والكرت */
        .card {
            display: none;
            background: rgba(255, 255, 255, 0.95);
            padding: 40px 30px;
            border-radius: 20px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.2);
            max-width: 400px;
            animation: fadeIn 1s ease-in-out forwards;
        }

        h1 {
            color: #d32f2f;
            font-size: 2.2rem;
            margin-bottom: 15px;
        }

        p {
            color: #444;
            font-size: 1.2rem;
            line-height: 1.6;
        }

        /* تساقط الورود */
        .flower {
            position: absolute;
            top: -10%;
            font-size: 2rem;
            user-select: none;
            animation: fall linear infinite;
        }

        /* التحريكات (Animations) */
        @keyframes bounce {
            0%, 20%, 50%, 80%, 100% {transform: translateY(0);}
            40% {transform: translateY(-20px);}
            60% {transform: translateY(-10px);}
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: scale(0.8); }
            to { opacity: 1; transform: scale(1); }
        }

        @keyframes fall {
            to {
                transform: translateY(110vh) rotate(360deg);
            }
        }
    </style>
</head>
<body>

    <div class="container">
        <!-- صندوق الهدية -->
        <div id="gift" class="gift-box" onclick="openGift()">
            <div class="gift-ribbon"></div>
            <div class="gift-ribbon-horizontal"></div>
        </div>
        <p id="hint" style="margin-top: 20px; font-weight: bold; color: #b71c1c;">اضغط على الهدية لاكتشاف المفاجأة! ✨</p>

        <!-- كرت التهنئة -->
        <div id="card" class="card">
            <h1>🌸 عيد ميلاد سعيد! 🌸</h1>
            <p>
                في هذا اليوم المميز، أتمنى لك سنة مليئة بالنجاح، السعادة، واللحظات الجميلة التي لا تُنسى. 
                <br><br>
                دمت لمن تحب، وكل عام وأنت بآلاف الخير والأمل! 🎉✨
            </p>
        </div>
    </div>

    <script>
        // إشعار ترحيبي عند فتح الموقع
        window.onload = function() {
            alert("✨ مرحباً بك! هناك مفاجأة خاصة تنتظرك في الداخل... 🎁");
        };

        // فتح الهدية وتشغيل تساقط الورود
        function openGift() {
            document.getElementById('gift').style.display = 'none';
            document.getElementById('hint').style.display = 'none';
            document.getElementById('card').style.display = 'block';

            // إنشاء تساقط الورود
            for (let i = 0; i < 30; i++) {
                createFlower();
            }
        }

        function createFlower() {
            const flower = document.createElement('div');
            flower.classList.add('flower');
            
            // اختيار زهور مختلفة بشكل عشوائي
            const flowers = ['🌸', '🌹', '🌺', '🌷', '✨'];
            flower.innerText = flowers[Math.floor(Math.random() * flowers.length)];
            
            flower.style.left = Math.random() * 100 + 'vw';
            flower.style.animationDuration = Math.random() * 3 + 2 + 's';
            flower.style.fontSize = Math.random() * 20 + 20 + 'px';
            
            document.body.appendChild(flower);

            setTimeout(() => {
                flower.remove();
            }, 5000);
        }
    </script>
</body>
</html>
